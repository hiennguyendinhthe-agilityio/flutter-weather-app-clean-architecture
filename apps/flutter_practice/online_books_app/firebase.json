{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "online-books-app",
          "appId": "1:40673580949:android:7c9bfd8b35f2242d18889c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "online-books-app",
          "appId": "1:40673580949:ios:8b87ecd5aa80f14018889c",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "online-books-app",
          "configurations": {
            "android": "1:40673580949:android:7c9bfd8b35f2242d18889c",
            "ios": "1:40673580949:ios:8b87ecd5aa80f14018889c"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
