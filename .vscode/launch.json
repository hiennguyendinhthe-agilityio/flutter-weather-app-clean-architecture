{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run dev",
      "request": "launch",
      "type": "dart",
      "program": "apps/flutter_practice/bazar_books_app/lib/main.dart",
      "args": [
        "dev",
        "target",
        "aapps/flutter_practice/bazar_books_app/lib/main.dart"
      ]
    }, 
    {
        "name": "Run widgetbook",
        "request": "launch",
        "type": "dart",
        "program": "apps/flutter_practice/bazar_books_widgetbook/lib/main.dart",
        "args": [
          "widgetbook",
          "target",
          "aapps/flutter_practice/bazar_books_widgetbook/lib/main.dart"
        ]
      },
      {
        "name": "Run Device preview",
        "request": "launch",
        "type": "dart",
        "program": "apps/flutter_practice/bazar_books_app/lib/main_device_preview.dart",
        "args": [
          "Devicepreview",
          "target",
          "aapps/flutter_practice/bazar_books_widgetbook/lib/main_device_preview.dart"
        ]
      },
  ]
}